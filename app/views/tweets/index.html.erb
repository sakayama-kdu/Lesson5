<h1>Tweet一覧</h1>

<% if current_user %>
  <%= link_to "ログアウト", "/top/logout" %>
<% end %>

<hr>

<% @tweets.each do |t| %>

  <%= t.user.uid %>

  :

  <%= t.message %>

  <br>

  いいね数：

  <%= t.likes.count %>

  <br>

  <% if current_user %>
    <% like = current_user.likes.find_by(tweet_id: t.id) %>
    <% if like %>
      <%= button_to "いいね削除", like_path(like), method: :delete %>
    <% else %>
      <%= button_to "いいね", likes_path(tweet_id: t.id), method: :post %>
    <% end %>
  <% end %>

  <br>
  <br>

<% end %>