<h1>Tweet一覧</h1>

<% if current_user %>
  <%= link_to "ログアウト", "/top/logout" %>
<% end %>

<hr>

<% @tweets.each do |t| %>

  <%= t.user.uid %>

  :

  <%= t.message %>

  <br>

  いいね数：

  <%= t.likes.count %>

  <br>

  <% if current_user %>
    <% if t.liked?(current_user) %>
      <%= button_to "いいね削除", like_path(t), method: :delete %>
    <% else %>
      <%= button_to "いいね", likes_path(tweet_id: t.id), method: :post %>
    <% end %>
  <% end %>

  <br>
  <br>

<% end %>