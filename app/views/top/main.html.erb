<h1>つぶやきアプリ</h1>

<% if current_user %>

  ログイン中 :
  <%= current_user.uid %>

  <%= link_to "プロフィール", user_path(current_user) %>

  <%= link_to "ログアウト", "/top/logout" %>

<% else %>

  <%= link_to "ログイン", "/top/login_form" %>

  |

  <%= link_to "ユーザ登録", new_user_path %>

<% end %>

<%= link_to "ユーザ一覧", users_path %>

<hr>

<% if current_user %>
  <%= form_with model: Tweet.new do |f| %>
    <%= f.label :message, "ツイート" %>
    <%= f.text_area :message %>
    <%= f.submit "投稿" %>
  <% end %>
<% end %>

<% @tweets.each do |t| %>

  <% if t.user %>

    <%= t.user.uid %>

    :

    <%= t.message %>

    <br>

    いいね数: <%= t.likes.size %>

    <% if current_user %>
      <% if t.liked?(current_user) %>
        <%= button_to "いいね削除", like_path(t), method: :delete %>
      <% else %>
        <%= button_to "いいね", likes_path(tweet_id: t.id), method: :post %>
      <% end %>
    <% end %>

  <% end %>

<% end %>