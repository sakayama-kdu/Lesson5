<h1>ユーザ登録</h1>

<%= form_with model: @user do |f| %>

  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= f.label :uid, "UID" %>

  <%= f.text_field :uid %>

  <br>

  <%= f.label :password, "パスワード" %>

  <%= f.password_field :password %>

  <br>

  <%= f.label :password_confirmation, "パスワード（確認）" %>

  <%= f.password_field :password_confirmation %>

  <br>

  <%= f.submit "登録" %>

<% end %>